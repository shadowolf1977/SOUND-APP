yaml
name: Build Android APK

on:
  push:
    branches: [ "main" ] # Change to "master" if your branch uses the old name
  pull_request:
    branches: [ "main" ]

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
    # Step 1: Check out the repository source code
    - name: Checkout Code
      uses: actions/checkout@v4

    # Step 2: Set up Java Development Kit (JDK)
    - name: Set up JDK 17
      uses: actions/setup-java@v4
      with:
        distribution: 'zulu' # You can also use 'temurin'
        java-version: '17'   # Match this with your project's Java version

    # Step 3: Grant execute permission for the Gradle wrapper
    - name: Grant Execute Permission for Gradle
      run: chmod +x gradlew

    # Step 4: Run the Gradle build command to generate a Debug APK
    - name: Build Debug APK
      run: ./gradlew assembleDebug

    # Step 5: Upload the generated APK so you can download it
    - name: Upload APK Artifact
      uses: actions/upload-artifact@v4
      with:
        name: android-debug-apk
        path: app/build/outputs/apk/debug/app-debug.apk
